; Skyfall Legends — Godot 4.7 project configuration
; Original online-multiplayer battle royale prototype.

config_version=5

[application]

config/name="Skyfall Legends"
config/description="Original, self-hosted online multiplayer battle royale for Android."
config/version="0.8.0"
run/main_scene="res://game/scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.043, 0.074, 0.121, 1)
boot_splash/fullsize=true
config/icon="res://game/images/icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=30
3d/default_gravity=24.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/directional_shadow/size=2048
